APP_ENV=development
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EXTRACTION_MODEL=gpt-4o
ACCOUNT_SEARCH_URL=http://localhost:8001
ACCOUNTS_OFFLINE=0

# PostgreSQL
DATABASE_URL=postgresql://pcg:pcg@localhost:5432/pcg_maroc_ai

# Binary storage. Use memory only for tests/local throwaway development.
# Real deployments must use s3. Cloudflare R2 is S3-compatible.
STORAGE_BACKEND=s3
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=pcg
# Generic S3-compatible alternatives (optional instead of the R2 aliases):
# OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_REGION=auto

JWT_SECRET=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
ENABLE_AUTO_PUBLISH=0
ACCOUNTING_ENGINE_CERTIFIED=0
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
ACCESS_COOKIE_NAME=pcg_access
REFRESH_COOKIE_NAME=pcg_refresh
CORS_ORIGINS=http://localhost:3000
